# Datasets, reference genome and preprocessed tracks. These are large and are
# obtained from public sources; see the README for how to build data/.
data/
*.fa
*.fa.gz
*.fai
*.chrom.sizes

# Trained weights and the fitted sequence encoder. Both are regenerated
# deterministically by scripts/train.py from the seed recorded in each run's
# config_snapshot.yaml, so they do not belong in version control.
*.pt
*.pth
*.pkl

# Results that ARE tracked: eval_results.npz, history.json,
# config_snapshot.yaml and the JSON reports written by the analysis scripts.
# Plots are regenerated by scripts/build_results.py, so they are not.
*.png
figures/

# Per-machine progress for run.py. Local to whoever is running the experiments.
results/run_state.json
results/logs/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
env/
.ipynb_checkpoints/

# Editors and operating systems
.vscode/
.idea/
.DS_Store
*.swp

# Logs and archives
*.log
*.zip
*.tar.gz
